@page
@model Bookshelf.Pages.Library.IndexModel
@using Bookshelf.Models.DTOs.Library
@using Bookshelf.Helpers

@{
  ViewData["Title"] = "Mi biblioteca";
}

<section>

  <header class="mb-4">
    <h1>Mi biblioteca</h1>
  </header>

  @if (!Model.Books.Any())
  {
    <p>Todavía no sigues ningún libro.</p>
  }
  else
  {
    <div class="list-group">

      @foreach (LibraryBookDto book in Model.Books)
      {
        <article class="list-group-item">

          <h2 class="h5 mb-1">
            @book.Title
          </h2>

          <p class="mb-2">
            @book.Author
          </p>

          <form method="post" asp-page-handler="Status" class="mt-2">

            <input type="hidden" name="bookId" value="@book.BookId" />

            <label class="form-label">
                Estado
            </label>

            <select name="status" class="form-select" onchange="this.form.submit()">

              @foreach (var status in BookStatusHelper.GetAllStatus())
              {
                if (status.Key == book.Status)
                {
                  <option value="@status.Key" selected>
                    @status.Value
                  </option>
                }
                else
                {
                  <option value="@status.Key">
                    @status.Value
                  </option>
                }
              }

            </select>

          </form>

          <p class="mb-0">
            Valoración:
            @(book.Rating?.ToString() ?? "-")
          </p>

        </article>
      }

    </div>
  }

</section>
