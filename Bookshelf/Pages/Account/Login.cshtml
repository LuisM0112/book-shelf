@page
@model Bookshelf.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="container py-4">

  <div class="row justify-content-center">

    <div class="col-md-6 col-lg-5">

      <article class="card shadow-sm">

        <div class="card-body">

          <header class="mb-4 text-center">
            <h1 class="h3">
              Iniciar sesión
            </h1>
          </header>

          <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
            </div>

            <fieldset>

              <legend class="visually-hidden">
                  Inicio de sesión
              </legend>

              <div class="mb-3">

                <label asp-for="Login.Identifier" class="form-label"></label>

                <input asp-for="Login.Identifier" class="form-control" />

                <span asp-validation-for="Login.Identifier" class="text-danger"></span>

              </div>

              <div class="mb-3">

                <label asp-for="Login.Password" class="form-label"></label>

                <input asp-for="Login.Password" class="form-control" />

                <span asp-validation-for="Login.Password" class="text-danger"></span>

              </div>

              <div class="form-check mb-4">

                <input asp-for="Login.RememberMe" class="form-check-input" />

                <label asp-for="Login.RememberMe" class="form-check-label"></label>

              </div>

            </fieldset>

            <button type="submit" class="btn btn-primary w-100">
              Iniciar sesión
            </button>

          </form>

        </div>

      </article>

    </div>

  </div>

</section>
