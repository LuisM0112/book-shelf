@page
@model Bookshelf.Pages.Books.CreateModel

@{
    ViewData["Title"] = "Nuevo libro";
}

<section class="container">

  <header class="mb-4">
      <h1>Nuevo libro</h1>
  </header>

  <form method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
    </div>

    <div class="mb-3">
      <label asp-for="Book.Title" class="form-label"></label>
      <input asp-for="Book.Title" class="form-control" />
      <span asp-validation-for="Book.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
      <label asp-for="Book.Author" class="form-label"></label>
      <input asp-for="Book.Author" class="form-control" />
      <span asp-validation-for="Book.Author" class="text-danger"></span>
    </div>

    <div class="mb-3">
      <label asp-for="Book.ReleaseDate" class="form-label"></label>
      <input asp-for="Book.ReleaseDate" class="form-control" />
      <span asp-validation-for="Book.ReleaseDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
      <label asp-for="Book.ISBN" class="form-label"></label>
      <input asp-for="Book.ISBN" class="form-control" />
      <span asp-validation-for="Book.ISBN" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
      Crear libro
    </button>

  </form>

</section>