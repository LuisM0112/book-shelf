@page
@model IndexModel
@using Bookshelf.Models.DTOs.Books

@{
  ViewData["Title"] = "Catálogo";
}

<section>

  <header class="mb-4">
    <h1>Catálogo</h1>
    @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
    {
      <a asp-page="/Proposals/Create" class="btn btn-outline-primary">
        Proponer libro
      </a>
    }
    @if (User.IsInRole("Admin"))
    {
      <a asp-page="/Books/Create" class="btn btn-primary">
        Nuevo libro
      </a>
    }
  </header>

  @if (!Model.Books.Any())
  {
    <p>No hay libros disponibles.</p>
  }
  else
  {
    <div class="list-group">

      @foreach (BookListDto book in Model.Books)
      {
        <article class="list-group-item">

          <h2 class="h5 mb-1">
            @book.Title
          </h2>

          <p class="mb-3">
            @book.Author
          </p>

          @if (User.Identity?.IsAuthenticated == true)
          {
            @if (book.IsFollowing)
            {
              <form method="post"
                    asp-page-handler="Unfollow"
                    asp-route-id="@book.Id"
                    class="d-inline confirm-form"
                    data-title="¿Dejar de seguir?"
                    data-text="El libro '@book.Title' desaparecerá de tu biblioteca."
                    data-confirm-button="Dejar de seguir"
                    data-icon="warning">

                <button type="submit" class="btn btn-success">
                  Siguiendo
                </button>

              </form>
            }
            else
            {
              <form method="post"
                    class="d-inline"
                    asp-page-handler="Follow"
                    asp-route-id="@book.Id">

                <button type="submit" class="btn btn-primary">
                  Seguir
                </button>

              </form>
            }
          }

          @if (User.IsInRole("Admin"))
          {
            <a asp-page="/Books/Edit" asp-route-id="@book.Id" class="btn btn-outline-warning">
              Editar
            </a>

            <form method="post"
              asp-page="/Books/Delete"
              asp-route-id="@book.Id"
              class="d-inline confirm-form"
              data-title="¿Eliminar libro?"
              data-text="Se eliminará '@book.Title'. Esta acción no puede deshacerse."
              data-confirm-button="Eliminar"
              data-icon="warning">

            <button type="submit" class="btn btn-outline-danger">
              Eliminar
            </button>

        </form>
          }

        </article>
      }

    </div>
  }

</section>
